# Copy to secrets.yaml next to tesla-ble.yaml. All values are EXAMPLES – use your own.
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
wifi_hotspot_password: "fallback-hotspot-password"   # the ESP32 opens this hotspot if Wi-Fi fails
ota_password: "a-password-for-updates"

# 32 random bytes, base64 – e.g. `openssl rand -base64 32`
api_encryption_key: "REPLACE+with+your+own+32+byte+base64+key+abc="

# The car
tesla_vin: "LRWYGCEK0SB000001"              # 17 characters, Tesla app → Software
ble_mac_address: "A0:B1:C2:D3:E4:F5"        # the car's Bluetooth MAC – see docs/ble.md (“Find the MAC address”)

# The ESP32's web server – the bridge logs in with these (type them on the dashboard, Settings → Bluetooth).
# Use a long random password, e.g. `openssl rand -hex 16`.
web_username: "bridge"
web_password: "REPLACE-with-a-long-random-password"
