{
  "host": "0.0.0.0",
  "port": 4443,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "tesla_telemetry",
  "reliable_ack": false,
  "rate_limit": {
    "enabled": true,
    "message_interval_time": 30,
    "message_limit": 1000
  },
  "mqtt": {
    "broker": "${Bridge__Mqtt__Host}:${Bridge__Mqtt__Port}",
    "client_id": "fleet-telemetry",
    "username": "fleet-telemetry",
    "password": "${FT_MQTT_PASSWORD}",
    "topic_base": "telemetry",
    "qos": 1,
    "retained": false
  },
  "records": {
    "V": ["mqtt"],
    "connectivity": ["mqtt"],
    "alerts": ["mqtt"],
    "errors": ["mqtt"]
  },
  "tls": {
    "server_cert": "/etc/fleet-telemetry/certs/fullchain.pem",
    "server_key": "/etc/fleet-telemetry/certs/privkey.pem"
  }
}
