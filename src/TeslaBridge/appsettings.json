{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft": "Warning" } },
  "Bridge": {
    "Mqtt": {
      "Host": "mosquitto",
      "Port": 1883,
      "Username": "tesla-bridge",
      "Password": "",
      "TelemetryTopicBase": "telemetry",
      "BridgeTopicBase": "tesla",
      "DiscoveryPrefix": "homeassistant"
    },
    "Tesla": {
      "Region": "eu",
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "",
      "PartnerDomain": "",
      "FleetKeyFile": "/config/tesla-proxy/fleet-key.pem",
      "ProxyUrl": "https://tesla-proxy:4443",
      "ProxyCertFile": "/config/tesla-proxy/tls-cert.pem",
      "TokenFile": "/data/tokens.json"
    },
    "Vehicles": [],
    "Telemetry": {
      "Hostname": "",
      "Port": 4443,
      "CaFile": "/config/bridge/vehicle-trust-ca.pem",
      "FieldsFile": "/config/bridge/telemetry-fields.json",
      "ConfigLifetimeDays": 30,
      "RenewWhenDaysLeft": 23,
      "AutoPush": true
    },
    "Commands": {
      "OptimisticTimeoutSeconds": 45,
      "WakeTimeoutSeconds": 60
    },
    "StateFile": "/data/state.json"
  }
}
