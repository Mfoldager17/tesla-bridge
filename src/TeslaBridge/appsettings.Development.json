    },
    "Vehicles": [ { "Vin": "SIMULERET00000001", "Name": "Model Y" } ],
    "Web": { "Port": 8080, "PublicPort": 8091, "Simulator": true },
    "StateFile": "../../data/state.json",
    "UsageFile": "../../data/usage.json"
  }
