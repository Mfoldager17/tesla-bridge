{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft": "Warning", "MQTTnet": "Warning" } },
  "Bridge": {
    "Mqtt": {
      "EmbeddedBroker": true,
      "Host": "localhost",
      "Port": 1883,
      "Username": ""
    },
    "Tesla": {
      "ProxyUrl": "https://localhost:4443",
      "ProxyCertFile": "../../config/tesla-proxy/tls-cert.pem",
