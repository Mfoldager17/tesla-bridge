# Copy to .env and fill in. Everything specific to you lives here – the server needs no files other than docker-compose.yml.
# All values below are EXAMPLES. Replace them with your own.
TZ=Europe/Copenhagen

# Your user's uid/gid (run `id`). All containers run as this user, and ./config + ./data are owned by it.
PUID=1000
PGID=1000

# The public name of the bridge. Used for three things:
#   https://<name>                → the app's Allowed Origin + public key (reverse proxy or tunnel → bridge :8091)
#   https://<name>/auth/callback  → the app's Allowed Redirect URI
#   <name>:4443                   → the car sends telemetry here (port forward → fleet-telemetry, DNS only)
# EXAMPLE – use your own (sub)domain. The name is up to you, but it must NOT contain "tesla" (Tesla rejects it).
# The certificate in config/fleet-telemetry/certs/ must be valid for this name.
TPitwall__Telemetry__Hostname=car.example.com
TPitwall__Telemetry__Port=4443
# Tunnel (e.g. Cloudflare Tunnel) instead of a reverse proxy? Then the website part needs its own name, because the
# tunnel can't carry the car's port 4443. Set the name THROUGH THE TUNNEL here, and the DNS-only name above:
#   TPitwall__Telemetry__Hostname=car-data.example.com   (DNS only → your public IP, port 4443)
#   TPitwall__Tesla__PartnerDomain=car.example.com       (tunnel → <server-IP>:8091; Allowed Origin/Redirect URI use this)
# Empty = the same as TPitwall__Telemetry__Hostname.
TPitwall__Tesla__PartnerDomain=

# Your car (the VIN is in the Tesla app under Software, or at the bottom of the windshield). More cars: __1__, __2__ …
TPitwall__Vehicles__0__Vin=
# The name is up to you: it becomes the device name in HA and the prefix of every entity id ("Model Y" → sensor.model_y_battery_level).
TPitwall__Vehicles__0__Name=Model Y
# Optional: an ESP32 with the Tesla BLE firmware near where the car parks (esphome/tesla-ble.yaml, docs/ble.md).
# While the car is in Bluetooth range, commands and wake-ups go that way – free. Can also be set on the dashboard.
#   TPitwall__Vehicles__0__Ble__Url=http://192.168.1.50
#   TPitwall__Vehicles__0__Ble__Username=     (web_username / web_password from the ESP32's secrets.yaml)
#   TPitwall__Vehicles__0__Ble__Password=
TPitwall__Vehicles__0__Ble__Url=

# Your NEW Tesla app (developer.tesla.com) for the bridge
TPitwall__Tesla__ClientId=
TPitwall__Tesla__ClientSecret=

# ---------- MQTT: pick ONE of two ways ----------
#
# A) Your own broker (e.g. Mosquitto, which you may already run for Zigbee2MQTT). HA gets the entities via MQTT discovery.
#    Use the IP, not localhost: both the bridge and fleet-telemetry run in containers and must be able to reach it.
#    If your broker is anonymous (no users), leave the usernames and passwords empty.
#
# B) No broker: set TPitwall__Mqtt__EmbeddedBroker=true. The bridge starts a small broker of its own that
#    only fleet-telemetry talks to (Host is ignored). HA then uses the "T-Pitwall" integration
#    (Mfoldager17/ha-t-pitwall, from the Marketplace) instead of MQTT.
TPitwall__Mqtt__EmbeddedBroker=false
TPitwall__Mqtt__Host=192.168.0.x
TPitwall__Mqtt__Port=1883
TPitwall__Mqtt__Username=t-pitwall
TPitwall__Mqtt__Password=
# fleet-telemetry (receives data from the car) logs in to the broker with its own user.
# Written to config/fleet-telemetry/config.json automatically on start.
TPitwall__Telemetry__MqttUsername=fleet-telemetry
TPitwall__Telemetry__MqttPassword=
# MQTT discovery for HA. Empty it (TPitwall__Mqtt__DiscoveryPrefix=) if you use the integration instead.
TPitwall__Mqtt__DiscoveryPrefix=homeassistant

# Dashboard and API on http://<server>:8090 – it can unlock the car, so it always needs a token. Empty: the bridge
# makes one on first start (docker compose exec t-pitwall cat /data/web-token). The HA integration uses the
# same address and token. (TPitwall__Web__Enabled=false turns both off.) See docs/security.md.
TPitwall__Web__Token=
# DASHBOARD_BIND=192.168.1.10          # listen for the dashboard on this address only (default: all)
# TPitwall__Mqtt__Commands=false         # no commands over MQTT – only through the HTTP API with its token

# Which version of the bridge to run (ghcr.io): latest = the newest release · v1 / v1.2 / v1.2.0 = pinned ·
# edge = every change on main, between releases. See docs/updating.md.
TPITWALL_TAG=latest
# The bridge looks up new releases on GitHub every 6 hours (shown in HA under Updates and on the dashboard).
# TPitwall__Updates__Check=false

# The dashboard's map and street address use OpenStreetMap (can be turned off under Settings). Other services:
# TPitwall__Map__GeocoderUrl=https://nominatim.openstreetmap.org
# TPitwall__Map__TileUrl=https://tile.openstreetmap.org/{z}/{x}/{y}.png
