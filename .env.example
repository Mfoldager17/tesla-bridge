# Copy to .env and fill in. Everything specific to you lives here – the server needs no files other than docker-compose.yml.
# All values below are EXAMPLES. Replace them with your own.
TZ=Europe/Copenhagen

# Your user's uid/gid (run `id`). All containers run as this user, and ./config + ./data are owned by it.
PUID=1000
PGID=1000

# The public name of the bridge. Used for three things:
#   https://<name>                → the app's Allowed Origin + public key (reverse proxy → bridge :8091)
#   https://<name>/auth/callback  → the app's Allowed Redirect URI
#   <name>:4443                   → the car sends telemetry here (port forward → fleet-telemetry)
# EXAMPLE – use your own (sub)domain. The name is up to you, but it must NOT contain "tesla" (Tesla rejects it).
Bridge__Telemetry__Hostname=car.example.com
Bridge__Telemetry__Port=4443

# Your car (the VIN is in the Tesla app under Software, or at the bottom of the windshield). More cars: __1__, __2__ …
Bridge__Vehicles__0__Vin=
# The name is up to you: it becomes the device name in HA and the prefix of every entity id ("Model Y" → sensor.model_y_battery_level).
Bridge__Vehicles__0__Name=Model Y

# Your NEW Tesla app (developer.tesla.com) for the bridge
Bridge__Tesla__ClientId=
Bridge__Tesla__ClientSecret=

# ---------- MQTT: pick ONE of two ways ----------
#
# A) Your own broker (e.g. Mosquitto, which you may already run for Zigbee2MQTT). HA gets the entities via MQTT discovery.
#    Use the IP, not localhost: both the bridge and fleet-telemetry run in containers and must be able to reach it.
#    If your broker is anonymous (no users), leave the usernames and passwords empty.
#
# B) No broker: set Bridge__Mqtt__EmbeddedBroker=true. The bridge starts a small broker of its own that
#    only fleet-telemetry talks to (Host is ignored). HA then uses the "Tesla Bridge" integration
#    (custom_components/tesla_bridge via HACS) instead of MQTT.
Bridge__Mqtt__EmbeddedBroker=false
Bridge__Mqtt__Host=192.168.0.x
Bridge__Mqtt__Port=1883
Bridge__Mqtt__Username=tesla-bridge
Bridge__Mqtt__Password=
# fleet-telemetry (receives data from the car) logs in to the broker with its own user.
# Written to config/fleet-telemetry/config.json automatically on start.
Bridge__Telemetry__MqttUsername=fleet-telemetry
Bridge__Telemetry__MqttPassword=
# MQTT discovery for HA. Empty it (Bridge__Mqtt__DiscoveryPrefix=) if you use the integration instead.
Bridge__Mqtt__DiscoveryPrefix=homeassistant

# Dashboard and API on http://<server>:8090. A token is strongly recommended – the API can unlock the car.
# The HA integration uses the same address and token. (Bridge__Web__Enabled=false turns both off.)
Bridge__Web__Token=

# Which version of the bridge to run (ghcr.io). "latest" = newest from main, or e.g. "v1.2.0".
BRIDGE_TAG=latest
