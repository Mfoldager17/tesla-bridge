# Kopiér til .env og udfyld. Alt dit eget står her – serveren skal ikke have andre filer end docker-compose.yml.
TZ=Europe/Copenhagen

# Din brugers uid/gid (kør `id`). Alle containere kører som den, og ./config + ./data ejes af den.
PUID=1000
PGID=1000

# Det offentlige navn for bridgen. Bruges til tre ting:
#   https://<navn>          → appens Allowed Origin + offentlig nøgle (NPM → bridge :8091)
#   https://<navn>/auth/callback → appens Allowed Redirect URI
#   <navn>:4443              → bilen sender telemetri hertil (port forward → fleet-telemetry)
Bridge__Telemetry__Hostname=tesla.ditdomaene.dk
Bridge__Telemetry__Port=4443

# Din bil (VIN står i Tesla-appen under Software eller i bunden af forruden). Flere biler: __1__, __2__ …
Bridge__Vehicles__0__Vin=
Bridge__Vehicles__0__Name=Model Y

# Din NYE Tesla-app (developer.tesla.com) til bridgen
Bridge__Tesla__ClientId=
Bridge__Tesla__ClientSecret=

# MQTT – din eksisterende broker (fx Mosquitto på Pi'en til Z2M). Brug IP'en, ikke localhost:
# både bridgen og fleet-telemetry kører i containere og skal kunne nå den.
# Er Mosquitto anonym (ingen brugere), så lad brugernavne og kodeord være tomme.
Bridge__Mqtt__Host=192.168.0.x
Bridge__Mqtt__Port=1883
Bridge__Mqtt__Username=tesla-bridge
Bridge__Mqtt__Password=
# fleet-telemetry (modtager data fra bilen) logger ind på samme broker med sin egen bruger.
# Skrives automatisk ind i config/fleet-telemetry/config.json ved start.
Bridge__Telemetry__MqttUsername=fleet-telemetry
Bridge__Telemetry__MqttPassword=

# Dashboard på http://<server>:8090. Token anbefales – dashboardet kan låse bilen op.
# Slå dashboardet fra i prod med: Bridge__Web__Enabled=false
Bridge__Web__Token=

# Hvilken version af bridgen der køres (ghcr.io). "latest" = nyeste fra main, eller fx "v1.2.0".
BRIDGE_TAG=latest
